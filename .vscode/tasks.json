{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (Django)",
      "type": "shell",
      "command": "${workspaceFolder}/Backend/venv/Scripts/python.exe",
      "args": [
        "manage.py",
        "runserver",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ML-Backend (FastAPI)",
      "type": "shell",
      "command": "${workspaceFolder}/ML-Backend/.venv/Scripts/uvicorn.exe",
      "args": [
        "app.main:app",
        "--port",
        "8100"
      ],
      "options": {
        "cwd": "${workspaceFolder}/ML-Backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend (Next.js)",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start All Servers",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend (Django)",
        "ML-Backend (FastAPI)",
        "Frontend (Next.js)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
