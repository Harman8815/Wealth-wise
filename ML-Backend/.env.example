# ML-Backend environment variables

# Ollama
OLLAMA_URL=http://localhost:11434

# Backend API (Django)
BACKEND_API_URL=http://localhost:8000/api

# JWT — shared secret with backend/ (must match backend/ SECRET_KEY)
JWT_SECRET=change-me-in-production

# App
PORT=8100
LOG_LEVEL=info

# Data
DATABASE_URL=sqlite:///./data/ml_backend.db
